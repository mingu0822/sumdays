OPENAI_API_KEY=키붙여넣기
AI_SERVER_PORT=5001
NODEJS_SERVER_PORT=3000
PYTHON_AI_URL=http://localhost:5001
AUDIO_MODEL=whisper-1
GPT_MODEL=gpt-4.1-nano
IMAGE_MODEL=gpt-4o-mini
GOOGLE_APPLICATION_CREDENTIALS=절대경로
GOOGLE_PLAY_PACKAGE_NAME=com.example.first
# Android Publisher 권한이 있는 서비스 계정 JSON의 절대 경로.
# GOOGLE_APPLICATION_CREDENTIALS와 같은 파일을 써도 됩니다.
GOOGLE_PLAY_SERVICE_ACCOUNT_FILE=절대경로
# Pub/Sub push 구독의 OIDC 토큰 검증값
GOOGLE_PLAY_RTDN_AUDIENCE=https://api.example.com/api/google-play/rtdn
GOOGLE_PLAY_RTDN_PUSH_SERVICE_ACCOUNT=pubsub-push@프로젝트ID.iam.gserviceaccount.com
