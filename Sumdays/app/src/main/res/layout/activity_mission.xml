<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/missionRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFDF8"
    android:clipChildren="false"
    android:clipToPadding="false"
    tools:context=".MissionActivity">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:background="#FFFDF8"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:outlineProvider="none"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- 일기 화면(activity_sum.xml back_icon)과 같은 ImageView 설정 -->
        <ImageView
            android:id="@+id/backButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="13dp"
            android:contentDescription="뒤로가기"
            android:src="@drawable/ic_arrow_back_grey" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/pointCenterTabs"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:background="#FFFDF8"
        android:elevation="8dp"
        android:outlineProvider="none"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tabPointQuest"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="퀘스트"
                android:textColor="@color/foxrange"
                android:textSize="16sp"
                android:textStyle="bold" />

            <View
                android:id="@+id/pointQuestIndicator"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:background="@color/foxrange" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tabPointPurchase"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="구매"
                android:textColor="#8C857C"
                android:textSize="16sp"
                android:textStyle="bold" />

            <View
                android:id="@+id/pointPurchaseIndicator"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:background="@color/foxrange"
                android:visibility="invisible" />
        </LinearLayout>
    </LinearLayout>

    <!-- 옷장(activity_customize.xml customizeViewport)과 같은 구조: 스크롤 내용이 이 틀 밖(네비바 위 24dp,
         네비바 주변)으로 그려지지 않게 잘라서 그 영역은 배경색으로 보이게 한다. -->
    <FrameLayout
        android:id="@+id/missionViewport"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="24dp"
        android:clipChildren="true"
        app:layout_constraintTop_toBottomOf="@id/pointCenterTabs"
        app:layout_constraintBottom_toTopOf="@id/navigation_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMissions"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp"
        tools:itemCount="4"
        tools:listitem="@layout/item_mission" />

    <ScrollView
        android:id="@+id/pointPurchaseContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingStart="12dp"
        android:paddingTop="16dp"
        android:paddingEnd="12dp"
        android:paddingBottom="20dp"
        android:visibility="gone">

        <!-- ScrollView가 이 LinearLayout을 자기 경계로 잘라내므로, 카드 그림자가 들어갈 좌우 여백(8dp)을
             여기 안쪽에 두고 clipToPadding=false로 그 여백에 그림자가 그려지게 한다.
             카드 위치는 ScrollView 12dp + 8dp = 20dp로 기존과 같다. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingHorizontal="8dp"
            android:paddingBottom="8dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="포인트 구매"
                android:tag="theme_text_basic"
                android:textColor="#2D2A26"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp"
                android:text="Google Play 결제로 포인트를 충전할 수 있어요"
                android:textColor="#7A726A"
                android:textSize="13sp" />

            <FrameLayout
                android:background="@drawable/blockstyle_d_basic"
                android:elevation="2dp"
                android:id="@+id/cardAdMission"
                android:layout_width="match_parent"
                android:layout_height="112dp"
                android:layout_marginBottom="16dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="24dp">

                    <ImageView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:id="@+id/ivAdMissionIcon"
                        android:contentDescription="광고 재생"
                        android:padding="8dp"
                        android:src="@android:drawable/ic_media_play"
                        app:tint="@color/foxrange" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="광고 보고 포인트!"
                            android:tag="theme_text_basic"
                            android:textColor="#2D2A26"
                            android:textSize="21sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvAdMissionDescription"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="광고 시청 시 포인트를 바로 받을 수 있어요"
                            android:textColor="#7A726A"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:background="@drawable/bg_image_drawer_rounded_light"
                android:elevation="2dp"
                android:id="@+id/cardPoint1000"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="가볍게 충전"
                            android:textColor="#7A726A"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="1,000P"
                            android:tag="theme_text_basic"
                            android:textColor="#2D2A26"
                            android:textSize="22sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₩1,100"
                        android:tag="theme_text_accent"
                        android:textColor="@color/foxrange"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:background="@drawable/bg_image_drawer_rounded_light"
                android:elevation="2dp"
                android:id="@+id/cardPoint3300"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="기본 충전"
                            android:textColor="#7A726A"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="3,300P"
                            android:tag="theme_text_basic"
                            android:textColor="#2D2A26"
                            android:textSize="22sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₩3,300"
                        android:tag="theme_text_accent"
                        android:textColor="@color/foxrange"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:background="@drawable/bg_image_drawer_rounded_light"
                android:elevation="2dp"
                android:id="@+id/cardPoint5800"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="알뜰 충전 · 300P 추가"
                            android:textColor="#7A726A"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="5,800P"
                            android:tag="theme_text_basic"
                            android:textColor="#2D2A26"
                            android:textSize="22sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₩5,500"
                        android:tag="theme_text_accent"
                        android:textColor="@color/foxrange"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:background="@drawable/bg_image_drawer_rounded_light"
                android:elevation="2dp"
                android:id="@+id/cardPoint12000"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="넉넉하게 · 1,000P 추가"
                            android:textColor="#7A726A"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="12,000P"
                            android:tag="theme_text_basic"
                            android:textColor="#2D2A26"
                            android:textSize="22sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₩11,000"
                        android:tag="theme_text_accent"
                        android:textColor="@color/foxrange"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="Google Play 결제 화면에서 최종 금액을 확인할 수 있어요"
                android:textColor="#8C857C"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
    </FrameLayout>

    <include
        android:id="@+id/navigation_bar"
        layout="@layout/include_navigation_bar"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp"
        android:clipChildren="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
