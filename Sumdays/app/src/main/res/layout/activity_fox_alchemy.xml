<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline35"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.35" />

    <!-- 배경 -->
    <ImageView
        android:id="@+id/alchemy_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/alchemy_background"/>

    <!-- ===================== -->
    <!-- 재료 패널 -->
    <!-- ===================== -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/materialPanel"
        android:layout_width="0dp"
        android:layout_height="150dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="20dp"
        android:visibility="gone"
        android:elevation="10dp"
        app:cardBackgroundColor="#FFF8E8"
        app:cardCornerRadius="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="선택한 재료"
                android:textColor="@android:color/black"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- 안경 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/slotGlasses"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_slot"
                        android:padding="8dp"
                        android:src="@android:drawable/ic_input_add"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="안경"
                        android:textSize="12sp"/>
                </LinearLayout>

                <!-- 모자 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/slotHat"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_slot"
                        android:padding="8dp"
                        android:src="@android:drawable/ic_input_add"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="모자"
                        android:textSize="12sp"/>
                </LinearLayout>

                <!-- 목도리 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/slotScarf"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_slot"
                        android:padding="8dp"
                        android:src="@android:drawable/ic_input_add"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="목도리"
                        android:textSize="12sp"/>
                </LinearLayout>

                <!-- 악세사리 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/slotAccessory"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_slot"
                        android:padding="8dp"
                        android:src="@android:drawable/ic_input_add"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="악세"
                        android:textSize="12sp"/>
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- ===================== -->
    <!-- 솥 (맨 위) -->
    <!-- ===================== -->

    <ImageButton
        android:id="@+id/alchemy_pot"
        android:layout_width="695px"
        android:layout_height="860px"
        android:background="@drawable/alchemy_pot"
        android:stateListAnimator="@null"
        android:scaleType="centerInside"

        app:layout_constraintTop_toTopOf="@id/guideline35"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


    <!-- ===================== -->
    <!-- 여우 -->
    <!-- ===================== -->

    <ImageView
        android:id="@+id/alchemy_fox"
        android:layout_width="239px"
        android:layout_height="755px"
        android:background="@drawable/alchemy_fox"

        app:layout_constraintStart_toEndOf="@id/alchemy_pot"
        app:layout_constraintBottom_toBottomOf="@id/alchemy_pot"

        android:layout_marginStart="-60dp"
        android:layout_marginBottom="-80dp"/>

    <ImageView
        android:id="@+id/alchemyCloud"
        android:layout_width="330dp"
        android:layout_height="210dp"
        android:visibility="gone"
        android:alpha="0.75"
        android:src="@drawable/alchemy_cloud"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.34"/>

    <ImageView
        android:id="@+id/imgResultFox"
        android:layout_width="100dp"
        android:layout_height="1200dp"
        android:visibility="gone"
        android:scaleType="fitCenter"

        app:layout_constraintStart_toStartOf="@id/alchemyCloud"
        app:layout_constraintEnd_toEndOf="@id/alchemyCloud"
        app:layout_constraintTop_toTopOf="@id/alchemyCloud"
        app:layout_constraintBottom_toBottomOf="@id/alchemyCloud"/>

    <!-- ===================== -->
    <!-- 뒤로가기 -->
    <!-- ===================== -->

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_margin="16dp"
        android:background="@drawable/ic_alchemy_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>