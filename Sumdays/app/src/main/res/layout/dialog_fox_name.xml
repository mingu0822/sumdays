<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_fox_name_dialog"
    android:orientation="vertical"
    android:paddingStart="26dp"
    android:paddingTop="16dp"
    android:paddingEnd="26dp"
    android:paddingBottom="28dp">

    <ImageButton
        android:id="@+id/btnCloseFoxName"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="end"
        android:background="@android:color/transparent"
        android:contentDescription="닫기"
        android:padding="5dp"
        android:src="@drawable/ic_close" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="-20dp"
        android:text="조합 성공"
        android:textColor="#E86758"
        android:textSize="18sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="2dp"
        android:text="새로운 여우가 태어났어요!"
        android:textColor="#111111"
        android:textSize="23sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/imgFoxNamePreview"
        android:layout_width="210dp"
        android:layout_height="210dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="28dp"
        android:background="@drawable/bg_fox_preview_circle"
        android:padding="22dp"
        android:scaleType="fitCenter" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="이름"
        android:textColor="#333333"
        android:textSize="16sp" />

    <EditText
        android:id="@+id/editFoxName"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_fox_name_input"
        android:drawableEnd="@drawable/ic_pencil"
        android:drawablePadding="12dp"
        android:hint="여우 이름을 입력하세요"
        android:imeOptions="actionDone"
        android:maxLength="20"
        android:paddingStart="18dp"
        android:paddingEnd="14dp"
        android:singleLine="true"
        android:textColor="#222222"
        android:textColorHint="#A6A6A6"
        android:textSize="17sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGoCloset"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="28dp"
        android:text="옷장으로"
        android:textColor="@android:color/white"
        android:textSize="22sp"
        app:backgroundTint="@color/foxrange"
        app:cornerRadius="16dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCloseAfterNaming"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="12dp"
        android:text="닫기"
        android:textColor="@android:color/white"
        android:textSize="22sp"
        app:backgroundTint="#D8B2AD"
        app:cornerRadius="16dp" />
</LinearLayout>
