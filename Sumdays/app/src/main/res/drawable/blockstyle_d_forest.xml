<?xml version="1.0" encoding="utf-8"?>
<!-- forest 테마의 blockStyleD: blockstyle_d_basic과 같은 모양(r28, 테두리, 4dp 패딩)에 숲 블록색/초록 테두리 적용 -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#1F000000">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/theme_forest_block"/>
            <corners android:radius="28dp"/>
            <stroke
                android:width="1.5dp"
                android:color="@color/theme_forest_green"/>
            <padding
                android:top="4dp"
                android:left="4dp"
                android:right="4dp"
                android:bottom="4dp"/>
        </shape>
    </item>
</ripple>
